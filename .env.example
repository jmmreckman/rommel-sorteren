# Simpel gedeeld wachtwoord voor de site (los van Ayla/Jurian-naamkeuze)
SITE_PASSWORD=verander-mij

# Poort waarop de app draait binnen de container
PORT=8000

# E-mailmelding wanneer Ayla weer 10 foto's verwerkt heeft (optioneel -
# laat SMTP_HOST leeg om dit uit te zetten). Gewone SMTP-inloggegevens
# van je hostingpartij, zoals je ook in een mailprogramma zou invullen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@steenhub.nl
