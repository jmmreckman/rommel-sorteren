# Google Drive map met de foto's (map-ID uit de URL: drive.google.com/drive/folders/<DIT-STUK>)
DRIVE_FOLDER_ID=

# Pad naar het service-account sleutelbestand (zie README voor hoe je dit aanmaakt)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# Simpel gedeeld wachtwoord voor de site (los van Ayla/Jurian-naamkeuze)
SITE_PASSWORD=verander-mij

# Poort waarop de app draait binnen de container
PORT=8000

# Hoe vaak (in minuten) automatisch naar nieuwe foto's in de Drive-map wordt gezocht
SYNC_INTERVAL_MINUTES=2
